---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="홍길동의 홈페이지" description="배우고 만든 것을 기록하는 홍길동의 개인 홈페이지입니다.">
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">My Personal Homepage</p>
    <h1 id="hero-title">안녕하세요, 저는 홍길동입니다.</h1>
    <p class="intro">
      AI와 함께 만들고 검증한 작은 프로젝트와 배운 내용을 기록합니다.
    </p>
    <div class="actions" aria-label="주요 페이지 바로가기">
      <a class="button" href={`${base}projects/`}>프로젝트 보기</a>
      <a class="button secondary" href={`${base}about/`}>소개 읽기</a>
    </div>
  </section>

  <section class="section" aria-labelledby="explore-title">
    <div class="section-heading">
      <p class="eyebrow">Explore</p>
      <h2 id="explore-title">이 홈페이지에서 볼 수 있는 것</h2>
    </div>
    <div class="link-grid">
      <a class="link-panel" href={`${base}about/`}>
        <h3>About</h3>
        <p>어떤 관심을 가지고 배우고 있는지 소개합니다.</p>
      </a>
      <a class="link-panel" href={`${base}projects/`}>
        <h3>Projects</h3>
        <p>직접 만들고 검증한 작업과 배운 점을 보여줍니다.</p>
      </a>
      <a class="link-panel" href={`${base}posts/`}>
        <h3>Posts</h3>
        <p>배포와 AI 협업 과정에서 남긴 글 목록입니다.</p>
      </a>
    </div>
  </section>
</BaseLayout>
